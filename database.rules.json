{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["score"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "scores": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "users-online": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString()"
      }
    },
    "friendRequests": {
      "sent": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "received": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$from": {
            ".read": "auth != null && auth.uid === $from",
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $from && newData.child('status').val() === 'pending'))"
          }
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "matchmaking": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || !newData.exists())"
      }
    },
    "matches": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || newData.exists())"
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        "players": {
          ".write": "auth != null && !data.exists() && newData.child(auth.uid).exists()"
        },
        "ready": {
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('players').child($uid).exists()"
            }
          }
        },
        "live": {
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('players').child($uid).exists()"
            }
          }
        },
        "rematch": {
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('players').child($uid).exists()"
            }
          }
        },
        "left": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('players').child($uid).exists()"
          }
        }
      }
    }
  }
}
